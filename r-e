    def _render_json(self, data):
        s = json.dumps(data, ensure_ascii=False, indent=2)
        self.json_text.configure(state="normal")
        self.json_text.delete("1.0", tk.END)
        self.json_text.insert("1.0", s)
        self.json_text.configure(state="disabled")

    def _draw_sketch(self, data):
        c = self.sketch_canvas
        c.delete("all")
        w = max(c.winfo_width(), 900)
        h = max(c.winfo_height(), 500)

        # 배경 격자
        for x in range(20, w, 40):
            c.create_line(x, 0, x, h, fill="#f2e8d0")
        for y in range(20, h, 40):
            c.create_line(0, y, w, y, fill="#f2e8d0")

        c.create_text(24, 20, anchor="nw", text="AI 생성 그림란 - 초기 아이디어 스케치", font=("맑은 고딕", 15, "bold"), fill="#333")
        c.create_text(24, 50, anchor="nw", text="프레임, 바퀴, 모터, 감속기, 배터리, 제어기 배치 개념도", font=("맑은 고딕", 10), fill="#666")

        cx, cy = w * 0.48, h * 0.55
        body_w, body_h = min(420, w * 0.48), 170
        left, top = cx - body_w / 2, cy - body_h / 2
        right, bottom = cx + body_w / 2, cy + body_h / 2

        # 손그림 느낌의 차체 프레임
        c.create_polygon(
            left+30, top+10, right-30, top, right, top+45, right-10, bottom-20,
            right-60, bottom+5, left+55, bottom, left, bottom-35, left+18, top+38,
            outline="#222", fill="#d7ecff", width=3
        )
        c.create_rectangle(left+70, top+35, right-70, bottom-35, outline="#246", fill="#eef8ff", width=2)
        c.create_line(left+70, top+35, right-70, bottom-35, fill="#789", width=2)
        c.create_line(right-70, top+35, left+70, bottom-35, fill="#789", width=2)

        # 바퀴 배치
        wheel_count = int(data["input"]["driveWheels"])
        wheel_positions = []
        if wheel_count <= 2:
            wheel_positions = [(left+80, bottom+18), (right-80, bottom+18)]
        else:
            wheel_positions = [(left+70, top+25), (right-70, top+25), (left+70, bottom+20), (right-70, bottom+20)]
            if wheel_count >= 6:
                wheel_positions += [(cx, top+18), (cx, bottom+22)]
        for i, (x, y) in enumerate(wheel_positions[:max(2, min(wheel_count, 6))], start=1):
            c.create_oval(x-34, y-34, x+34, y+34, fill="#222", outline="#111", width=2)
            c.create_oval(x-22, y-22, x+22, y+22, fill="#777", outline="#ddd", width=2)
            c.create_text(x, y, text=f"W{i}", fill="white", font=("맑은 고딕", 8, "bold"))

        # 내부 부품
        motor_x, motor_y = left + body_w * 0.30, cy
        gear_x, gear_y = left + body_w * 0.43, cy
        bat_x, bat_y = left + body_w * 0.62, cy
        ctrl_x, ctrl_y = left + body_w * 0.75, top + 55
        sensor_x, sensor_y = right - 25, top - 25

        c.create_rectangle(motor_x-38, motor_y-25, motor_x+38, motor_y+25, fill="#ffcc80", outline="#9a5", width=2)
        c.create_text(motor_x, motor_y, text="MOTOR", font=("맑은 고딕", 8, "bold"))
        c.create_oval(gear_x-28, gear_y-28, gear_x+28, gear_y+28, fill="#ffe082", outline="#aa7", width=2)
        c.create_text(gear_x, gear_y, text="GEAR", font=("맑은 고딕", 8, "bold"))
        c.create_rectangle(bat_x-45, bat_y-25, bat_x+45, bat_y+25, fill="#c8e6c9", outline="#486", width=2)
        c.create_text(bat_x, bat_y, text="BATTERY", font=("맑은 고딕", 8, "bold"))
        c.create_rectangle(ctrl_x-38, ctrl_y-22, ctrl_x+38, ctrl_y+22, fill="#e1bee7", outline="#746", width=2)
        c.create_text(ctrl_x, ctrl_y, text="CTRL", font=("맑은 고딕", 8, "bold"))
        c.create_oval(sensor_x-18, sensor_y-18, sensor_x+18, sensor_y+18, fill="#b3e5fc", outline="#358", width=2)
        c.create_text(sensor_x, sensor_y, text="S", font=("맑은 고딕", 9, "bold"))

        # 콜아웃
        self._callout(c, motor_x, motor_y-28, 55, 115, f"모터\n{data['recommendation']['motorClass']}")
        self._callout(c, gear_x, gear_y+30, 55, h-130, f"감속비\n{data['result']['recommendedGearRatio']}:1")
        self._callout(c, bat_x, bat_y+28, w-300, h-130, f"배터리\n{data['input']['batteryVoltageV']}V {data['input']['batteryCapacityAh']}Ah")
        self._callout(c, ctrl_x, ctrl_y-25, w-300, 110, "제어기\n속도/전류 제어")
        self._callout(c, sensor_x, sensor_y-20, w-210, 55, "센서\n위치/장애물 인식")

        # 메모 박스
        memo = (
            f"목표: {data['input']['purpose']}\n"
            f"질량: {data['input']['massKg']} kg / 속도: {data['input']['targetSpeedMps']} m/s\n"
            f"요구출력: {data['result']['requiredMotorPowerW']} W\n"
            f"바퀴당 토크: {data['result']['requiredWheelTorquePerWheelNm']} N·m\n"
            f"주의: {data['result']['slipWarning']}"
        )
        c.create_rectangle(24, h-118, 390, h-20, fill="#fff8dc", outline="#c9a646", width=2)
        c.create_text(38, h-105, anchor="nw", text=memo, font=("맑은 고딕", 10), fill="#333")

    def _callout(self, c, x1, y1, x2, y2, text):
        c.create_line(x1, y1, x2, y2, fill="#555", width=2, arrow=tk.LAST)
        c.create_rectangle(x2-6, y2-6, x2+138, y2+48, fill="#ffffff", outline="#888")
        c.create_text(x2+5, y2+4, anchor="nw", text=text, font=("맑은 고딕", 9), fill="#222")

    def _draw_gear(self, data):
        c = self.gear_canvas
        c.delete("all")
        w = max(c.winfo_width(), 900)
        h = max(c.winfo_height(), 500)
        c.create_text(24, 20, anchor="nw", text="추천 기어비 개념 도면", font=("맑은 고딕", 15, "bold"), fill="#333")

        ratio = data["result"]["recommendedGearRatio"]
        cx1, cy = w * 0.36, h * 0.52
        cx2 = w * 0.62
        r1 = 45
        r2 = min(120, 45 + ratio * 2.0)

        c.create_oval(cx1-r1, cy-r1, cx1+r1, cy+r1, fill="#dbeafe", outline="#1d4ed8", width=3)
        c.create_oval(cx2-r2, cy-r2, cx2+r2, cy+r2, fill="#fee2e2", outline="#b91c1c", width=3)

        for i in range(16):
            a = 2 * math.pi * i / 16
            c.create_line(cx1, cy, cx1 + r1 * math.cos(a), cy + r1 * math.sin(a), fill="#1d4ed8")
        for i in range(28):
            a = 2 * math.pi * i / 28
            c.create_line(cx2, cy, cx2 + r2 * math.cos(a), cy + r2 * math.sin(a), fill="#b91c1c")

        c.create_text(cx1, cy, text="입력\n모터", font=("맑은 고딕", 10, "bold"))
        c.create_text(cx2, cy, text="출력\n휠", font=("맑은 고딕", 10, "bold"))
        c.create_line(cx1+r1, cy, cx2-r2, cy, fill="#444", width=2)
        c.create_text(w/2, 80, text=f"추천 감속비: {ratio}:1", font=("맑은 고딕", 16, "bold"), fill="#111")
        c.create_text(w/2, 115, text=f"이상 감속비: {data['result']['idealGearRatio']}:1 / 후보: {data['result']['gearCandidates']}", font=("맑은 고딕", 11), fill="#555")
        c.create_text(w/2, h-80, text="이 도면은 실제 치형 설계도가 아니라 초기 설계 방향 확인용 개념도입니다.", font=("맑은 고딕", 10), fill="#666")

    def copy_testbed_json(self):
        if self.last_design_data is None:
            messagebox.showwarning("복사할 데이터 없음", "먼저 [설계 데이터 및 스케치 생성하기] 버튼을 눌러 계산을 생성하세요.")
            return
        s = json.dumps(self.last_design_data, ensure_ascii=False, indent=2)
        self.clipboard_clear()
        self.clipboard_append(s)
        self.update()
        messagebox.showinfo("복사 완료", "테스트베드용 설계 데이터 JSON을 클립보드에 복사했습니다.")


