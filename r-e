    def apply_preset(self, name):
        data = PRESETS.get(name, {})
        if not data:
            return
        self.scale_var.set(str(data.get("scale", "")))
        self.purpose_var.set(str(data.get("purpose", "")))
        self.mass_var.set(str(data.get("mass", "")))
        self.speed_var.set(str(data.get("speed", "")))
        self.speed_unit_var.set(str(data.get("speed_unit", "m/s")))
        self.wheels_var.set(str(data.get("wheels", "")))
        self.wheel_diameter_var.set(str(data.get("wheel_diameter", "")))
        self.grade_var.set(str(data.get("grade", "")))
        self.environment_var.set(str(data.get("environment", "실내/경기장")))
        self.extra_var.set(str(data.get("extra", "")))

    def _read_float(self, var, name, min_value=None):
        try:
            value = float(var.get())
        except ValueError:
            raise ValueError(f"'{name}' 항목은 숫자로 입력해야 합니다.")
        if min_value is not None and value < min_value:
            raise ValueError(f"'{name}' 항목은 {min_value} 이상이어야 합니다.")
        return value

    def _read_int(self, var, name, min_value=None):
        try:
            value = int(float(var.get()))
        except ValueError:
            raise ValueError(f"'{name}' 항목은 정수로 입력해야 합니다.")
        if min_value is not None and value < min_value:
            raise ValueError(f"'{name}' 항목은 {min_value} 이상이어야 합니다.")
        return value

    def generate_design(self):
        try:
            scale = self.scale_var.get().strip()
            purpose = self.purpose_var.get().strip()
            mass = self._read_float(self.mass_var, "예상 총 질량 kg", 0.1)
            speed = self._read_float(self.speed_var, "목표 주행 속도", 0.01)
            speed_unit = self.speed_unit_var.get()
            target_speed_mps = speed / 3.6 if speed_unit == "km/h" else speed
            wheels = self._read_int(self.wheels_var, "구동 바퀴 수", 1)
            wheel_diameter = self._read_float(self.wheel_diameter_var, "바퀴 지름 m", 0.03)
            wheel_radius = wheel_diameter / 2.0
            grade_deg = self._read_float(self.grade_var, "목표 경사각 deg", 0)
            environment = self.environment_var.get()
            extra = self.extra_var.get().strip()
            motor_rpm = self._read_float(self.motor_rpm_var, "기준 모터 RPM", 100)
            safety_factor = self._read_float(self.safety_factor_var, "안전율", 1.0)
            voltage = self._read_float(self.voltage_var, "배터리 전압 V", 1.0)
            battery_ah = self._read_float(self.battery_ah_var, "배터리 용량 Ah", 0.1)
            accel_time = self._read_float(self.accel_time_var, "목표 가속시간 s", 0.1)
        except ValueError as e:
            messagebox.showerror("입력 오류", str(e))
            return

        env = ENV_PARAMS.get(environment, ENV_PARAMS["실내/경기장"])
        g = 9.81
        crr = env["crr"]
        mu = env["mu"]
        efficiency = env["eff"]
        grade_rad = math.radians(grade_deg)

        # 단순 물리 계산: 구름저항 + 등판저항 + 목표 가속에 필요한 힘
        rolling_force = mass * g * crr * math.cos(grade_rad)
        grade_force = mass * g * math.sin(grade_rad)
        accel_force = mass * target_speed_mps / accel_time
        aero_force = 0.5 * 1.225 * 0.8 * 0.7 * target_speed_mps ** 2  # 단순 CdA 가정
        required_force = (rolling_force + grade_force + accel_force + aero_force) * safety_factor
        traction_limit = mu * mass * g * math.cos(grade_rad)

        wheel_torque_total = required_force * wheel_radius
        wheel_torque_each = wheel_torque_total / wheels
        wheel_rpm = (target_speed_mps / (2 * math.pi * wheel_radius)) * 60
        ideal_gear_ratio = motor_rpm / max(wheel_rpm, 1e-6)

        # 보기 좋은 추천 기어비 후보
        standard_ratios = [3, 5, 7, 10, 12, 15, 18, 20, 25, 30, 36, 40, 50, 60, 80, 100]
        ranked = sorted(standard_ratios, key=lambda r: abs(math.log(r / max(ideal_gear_ratio, 0.1))))
        gear_candidates = ranked[:5]
        recommended_ratio = gear_candidates[0]

        output_wheel_power = required_force * target_speed_mps
        required_motor_power = output_wheel_power / max(efficiency, 0.1)
        current_est = required_motor_power / voltage
        battery_wh = voltage * battery_ah
        runtime_h = battery_wh / max(required_motor_power, 1)
        range_km = target_speed_mps * runtime_h * 3.6

        torque_margin = traction_limit / required_force if required_force > 0 else 999
        slip_warning = "접지력 부족 위험" if torque_margin < 1.0 else "접지력 여유 있음"

        if required_motor_power < 150:
            motor_class = "소형 BLDC/기어드 DC 모터급"
            motor_reco = "100~200 W급 BLDC 또는 DC 기어드 모터"
            controller = "12~24 V 소형 모터 드라이버"
        elif required_motor_power < 800:
            motor_class = "중형 BLDC 모터급"
            motor_reco = "300~800 W급 BLDC 모터"
            controller = "24~48 V BLDC 드라이버"
        elif required_motor_power < 3000:
            motor_class = "고출력 BLDC/PMSM 모터급"
            motor_reco = "1~3 kW급 BLDC 또는 PMSM 모터"
            controller = "48~72 V 인버터/모터 컨트롤러"
        else:
            motor_class = "차량용 고출력 모터급"
            motor_reco = "3 kW 이상급 PMSM/BLDC 구동계"
            controller = "고전압 인버터 및 BMS 연동 제어기"

        if recommended_ratio <= 10:
            gear_reco = "저감속 헬리컬/타이밍 벨트 감속 구조"
        elif recommended_ratio <= 30:
            gear_reco = "중감속 유성기어 또는 스퍼기어 감속기"
        else:
            gear_reco = "고감속 유성기어/웜기어 조합 검토"

        if environment in ["농지/비포장", "험지/비포장"]:
            wheel_reco = "대구경 러그/공압 타이어 또는 고접지 휠"
            frame_reco = "방수/방진을 고려한 고강성 프레임"
        elif environment == "실내/평탄면":
            wheel_reco = "저소음 우레탄/고무 바퀴"
            frame_reco = "경량 알루미늄 또는 3D 프린팅 프레임"
        else:
            wheel_reco = "우레탄/고무 복합 바퀴"
            frame_reco = "알루미늄 프로파일 또는 판재 프레임"

        budget = self._estimate_budget(required_motor_power, wheels, recommended_ratio)

        design_data = {
            "version": "python_initial_setting_fixed_v1",
            "source": "mobility_drive_initial_setting_system",
            "systemName": APP_TITLE,
            "input": {
                "scale": scale,
                "purpose": purpose,
                "massKg": mass,
                "targetSpeedInput": speed,
                "targetSpeedUnit": speed_unit,
                "targetSpeedMps": round(target_speed_mps, 4),
                "driveWheels": wheels,
                "wheelDiameterM": wheel_diameter,
                "wheelRadiusM": round(wheel_radius, 4),
                "gradeDeg": grade_deg,
                "environment": environment,
                "extraRequirements": extra,
                "motorBaseRpm": motor_rpm,
                "safetyFactor": safety_factor,
                "batteryVoltageV": voltage,
                "batteryCapacityAh": battery_ah,
                "targetAccelerationTimeS": accel_time
            },
            "result": {
                "rollingForceN": round(rolling_force, 3),
                "gradeForceN": round(grade_force, 3),
                "accelerationForceN": round(accel_force, 3),
                "aeroForceN": round(aero_force, 3),
                "requiredTractiveForceN": round(required_force, 3),
                "tractionLimitN": round(traction_limit, 3),
                "tractionMargin": round(torque_margin, 3),
                "slipWarning": slip_warning,
                "requiredWheelTorqueTotalNm": round(wheel_torque_total, 3),
                "requiredWheelTorquePerWheelNm": round(wheel_torque_each, 3),
                "requiredWheelRpm": round(wheel_rpm, 3),
                "idealGearRatio": round(ideal_gear_ratio, 3),
                "recommendedGearRatio": recommended_ratio,
                "gearCandidates": gear_candidates,
                "requiredMotorPowerW": round(required_motor_power, 3),
                "estimatedCurrentA": round(current_est, 3),
                "estimatedRuntimeH": round(runtime_h, 3),
                "estimatedRangeKm": round(range_km, 3),
                "driveEfficiency": efficiency,
                "rollingResistanceCoefficient": crr,
                "frictionCoefficient": mu
            },
            "recommendation": {
                "motorClass": motor_class,
                "motor": motor_reco,
                "gear": gear_reco,
                "wheel": wheel_reco,
                "controller": controller,
                "frame": frame_reco,
                "budgetKRW": budget
            }
        }

        self.last_design_data = design_data
        self._render_result(design_data)
        self._render_json(design_data)
        self._draw_sketch(design_data)
        self._draw_gear(design_data)

    def _estimate_budget(self, power_w, wheels, ratio):
        motor = max(60000, int(power_w * 350))
        gear = max(40000, int(ratio * 8000))
        wheel = wheels * 25000
        controller = max(50000, int(power_w * 180))
        battery = max(80000, int(power_w * 120))
        frame = 120000
        total = motor + gear + wheel + controller + battery + frame
        return {
            "motor": motor,
            "gearbox": gear,
            "wheels": wheel,
            "controller": controller,
            "battery": battery,
            "frame": frame,
            "total": total
        }

